\begin{tikzpicture}
  \definecolor{masterseparatesd}{RGB}{76,114,176}
  \definecolor{masteraggregatedsd}{RGB}{221,132,82}
  \definecolor{masterkktbigm}{RGB}{196,78,82}
  \definecolor{masterkktsos1}{RGB}{85,168,104}
  \begin{axis}[hide axis,scale only axis,width=.85\textwidth,height=0.6cm,xmin=0,xmax=1,ymin=0,ymax=1,
    legend columns=-1,legend style={name=masterlegend,at={(0,0.5)},anchor=west,draw=none,font=\footnotesize,/tikz/every even column/.append style={column sep=0.6em}},
    legend cell align={left}]
  \addlegendimage{empty legend}
  \addlegendentry{Master formulation:}
  % begin group IOM-All_(SSD) IOM-Top1_(SSD)
  \addlegendimage{color=masterseparatesd, solid, very thick, no marks}
  \addlegendentry{Separate SD}
  % end group
  % begin group IOM-All_(ASD) IOM-Top1_(ASD)
  \addlegendimage{color=masteraggregatedsd, solid, very thick, no marks}
  \addlegendentry{Aggregated SD}
  % end group
  % begin group IOM-All_(KKT-BigM) IOM-Top1_(KKT-BigM)
  \addlegendimage{color=masterkktbigm, solid, very thick, no marks}
  \addlegendentry{KKT big-M}
  % end group
  % begin group IOM-All_(KKT-SOS1) IOM-Top1_(KKT-SOS1)
  \addlegendimage{color=masterkktsos1, solid, very thick, no marks}
  \addlegendentry{KKT SOS1}
  % end group
  \end{axis}
  \begin{axis}[hide axis,scale only axis,width=.85\textwidth,height=0.6cm,xmin=0,xmax=1,ymin=0,ymax=1,
    legend columns=-1,legend style={at={(masterlegend.south west)},anchor=north west,draw=none,font=\footnotesize,/tikz/every even column/.append style={column sep=0.6em}},
    legend cell align={left}]
  \addlegendimage{empty legend}
  \addlegendentry{Method:}
  % begin group IOM-All_(SSD) IOM-All_(ASD) IOM-All_(KKT-BigM) IOM-All_(KKT-SOS1)
