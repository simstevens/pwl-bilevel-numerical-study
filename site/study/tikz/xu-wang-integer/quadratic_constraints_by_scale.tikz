  \definecolor{methodmibs}{RGB}{129,114,179}
  \begin{axis}[
    width=0.85\textwidth,
    height=0.52\textwidth,
    xlabel={Regional assignments},
    ylabel={Quadratic constraints},
    tick align=outside,
    axis lines=left,
    axis line style={black, line width=0.5pt},
    grid=both,
    major grid style={draw=black!8, line width=0.5pt},
    minor grid style={draw=black!8, line width=0.3pt},
    tick style={black, line width=0.5pt},
    tick label style={font=\footnotesize},
    label style={font=\footnotesize},
    every axis plot/.append style={line join=round},
    legend style={draw=none, font=\footnotesize},
    legend cell align={left},
    clip marker paths=true,
    enlarge y limits=0.05,
    xmode=log,
    enlarge x limits={lower=0.025,upper=0.05},
    log basis x=2,
  ]
  \addplot+[color=methodcbssd, dashed, very thick, mark=pentagon*, mark size=1.5pt] coordinates {(2,1) (4,2.5) (8,4) (16,4) (64,18) (256,36) (512,80) (4096,400)};
  \addplot+[color=methodcbasd, dashed, very thick, mark=star, mark size=1.5pt] coordinates {(2,1) (4,1) (8,1) (16,1) (64,1) (256,1) (512,1) (4096,1)};
  \addplot+[color=methodcbkktmcc, dashed, very thick, mark=triangle*, mark size=1.5pt, mark options={rotate=90}] coordinates {(2,0) (4,0) (8,0) (16,0) (64,0) (256,0) (512,0) (4096,0)};
  \addplot+[color=methodcbkktsos1, dashed, very thick, mark=triangle*, mark size=1.5pt, mark options={rotate=-90}] coordinates {(2,0) (4,0) (8,0) (16,0) (64,0) (256,0) (512,0) (4096,0)};
  \addplot+[color=methodssd, solid, very thick, mark=*, mark size=1.5pt] coordinates {(2,2) (4,4) (8,8) (16,16) (64,64) (256,256) (512,512) (4096,4096)};
  \addplot+[color=methodasd, solid, very thick, mark=square*, mark size=1.5pt] coordinates {(2,1) (4,1) (8,1) (16,1) (64,1) (256,1) (512,1) (4096,1)};
  \addplot+[color=methodkktmcc, solid, very thick, mark=triangle*, mark size=1.5pt] coordinates {(2,0) (4,0) (8,0) (16,0) (64,0) (256,0) (512,0) (4096,0)};
  \addplot+[color=methodkktsos1, solid, very thick, mark=diamond*, mark size=1.5pt] coordinates {(2,0) (4,0) (8,0) (16,0) (64,0) (256,0) (512,0) (4096,0)};
  \addplot+[color=methodmibs, solid, very thick, mark=triangle*, mark size=1.5pt, mark options={rotate=180}] coordinates {(2,0) (4,0) (8,0) (16,0) (64,0) (256,0) (512,0) (4096,0)};
