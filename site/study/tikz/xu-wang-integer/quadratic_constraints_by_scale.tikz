\begin{tikzpicture}[baseline=(current bounding box.north)]
  \definecolor{methodcbssd}{RGB}{76,114,176}
  \definecolor{methodcbasd}{RGB}{221,132,82}
  \definecolor{methodcbkktmcc}{RGB}{196,78,82}
  \definecolor{methodcbkktsos1}{RGB}{85,168,104}
  \definecolor{methodssd}{RGB}{76,114,176}
  \definecolor{methodasd}{RGB}{221,132,82}
  \definecolor{methodkktmcc}{RGB}{196,78,82}
